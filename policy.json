{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPortfolioBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-portfolio-patryk"
    },
    {
      "Sid": "ManagePortfolioObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::aws-portfolio-patryk/*"
    },
    {
      "Sid": "InvalidatePortfolioCache",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/E3NHUDKPMSUKL9"
    }
  ]
}